   "source": [
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "value = sns.load_dataset('tips')\n",
    "df = pd.DataFrame(value)\n",
    "\n",
    "df['mean_time'] = df.groupby('time')['total_bill'].transform('mean')\n",
    "\n",
    "df['total_bill'] = df['mean_time']\n",
    "df=df.drop('mean_time', axis=1)\n",
    "df"
   ]
  }
